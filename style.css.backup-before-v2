/* =========================================================
   CRICKET LIVE — CLEAN PREMIUM UI
   Single coherent stylesheet
   Preserves existing app.js / HTML hooks
========================================================= */

:root {
  --bg: #050607;
  --bg-soft: #080b09;
  --panel: #0b0e0c;
  --panel-2: #101411;
  --panel-3: #141914;

  --text: #f4f7f5;
  --text-soft: #d3dad5;
  --muted: #7f8a83;

  --green: #42f27a;
  --green-soft: rgba(66, 242, 122, .10);
  --green-border: rgba(66, 242, 122, .22);

  --red: #ff4055;
  --yellow: #ffbf38;

  --border: rgba(255,255,255,.075);
  --border-strong: rgba(255,255,255,.13);

  --container: 1180px;
  --radius-xl: 24px;
  --radius-lg: 18px;
  --radius-md: 14px;
  --radius-sm: 10px;

  --shadow: 0 24px 70px rgba(0,0,0,.38);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

[hidden] {
  display: none !important;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--text);
  background:
    radial-gradient(circle at 50% -15%, rgba(66,242,122,.075), transparent 34rem),
    radial-gradient(circle at 100% 40%, rgba(66,242,122,.035), transparent 30rem),
    var(--bg);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  line-height: 1.5;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .45;
  background-image:
    linear-gradient(rgba(255,255,255,.012) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.012) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: linear-gradient(to bottom, black, transparent 78%);
}

a,
button,
input {
  -webkit-tap-highlight-color: transparent;
}

button {
  font: inherit;
}

button,
a {
  cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 3px;
}

::selection {
  color: #041008;
  background: var(--green);
}

/* =========================================================
   HEADER
========================================================= */

.topbar {
  position: sticky;
  top: 0;
  z-index: 1000;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 max(22px, calc((100vw - var(--container)) / 2));
  background: rgba(5,6,7,.86);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--text);
  font-size: 20px;
  font-weight: 900;
  letter-spacing: -.4px;
}

.brand span {
  color: var(--green);
}

nav {
  display: flex;
  align-items: center;
  gap: 30px;
  margin-left: auto;
  margin-right: 34px;
}

nav a {
  position: relative;
  color: var(--muted);
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .7px;
  text-transform: uppercase;
  transition: color .2s ease;
}

nav a:hover {
  color: var(--text);
}

nav a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: -8px;
  height: 2px;
  border-radius: 99px;
  background: var(--green);
  transition: right .2s ease;
}

nav a:hover::after {
  right: 0;
}

.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 11px;
  color: #ff8b99;
  background: rgba(255,64,85,.065);
  border: 1px solid rgba(255,64,85,.20);
  border-radius: 999px;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.live-badge i {
  width: 7px;
  height: 7px;
  display: block;
  flex: 0 0 7px;
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 0 4px rgba(255,64,85,.08), 0 0 14px rgba(255,64,85,.45);
  animation: pulse 1.7s ease-in-out infinite;
}

/* =========================================================
   MAIN LAYOUT
========================================================= */

main {
  width: min(var(--container), calc(100% - 40px));
  margin: 0 auto;
  padding-bottom: 80px;
}

/* =========================================================
   HERO
========================================================= */

.hero {
  position: relative;
  min-height: 360px;
  margin-top: 28px;
  overflow: hidden;
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  background:
    radial-gradient(circle at 84% 50%, rgba(66,242,122,.13), transparent 27rem),
    linear-gradient(120deg, #0a0e0b 0%, #080b09 62%, #0c1510 100%);
  box-shadow: var(--shadow);
}

.hero::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -210px;
  top: -190px;
  border: 1px solid rgba(66,242,122,.08);
  border-radius: 50%;
  box-shadow:
    0 0 0 35px rgba(66,242,122,.018),
    0 0 0 75px rgba(66,242,122,.012);
  pointer-events: none;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .28;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: linear-gradient(90deg, black, transparent 72%);
}

.hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 58px 62px;
}

.hero-text {
  max-width: 680px;
}

.tag {
  display: inline-flex;
  margin-bottom: 17px;
  color: var(--green);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2.4px;
  text-transform: uppercase;
}

.hero h1 {
  max-width: 760px;
  color: var(--text);
  font-size: clamp(46px, 6.4vw, 78px);
  font-weight: 950;
  line-height: .94;
  letter-spacing: -4px;
}

.hero h1 span {
  color: var(--green);
}

.hero-description {
  max-width: 560px;
  margin-top: 20px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.75;
}

.hero-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 26px;
  padding: 13px 19px;
  color: #041008;
  background: var(--green);
  border: 1px solid rgba(66,242,122,.5);
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 12px 32px rgba(66,242,122,.12);
  transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
}

.hero-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.05);
  box-shadow: 0 16px 38px rgba(66,242,122,.20);
}

.hero-ball {
  position: absolute;
  right: 70px;
  top: 50%;
  width: 220px;
  height: 220px;
  margin: 0;
  transform: translateY(-50%);
  display: grid;
  place-items: center;
  border: 1px solid rgba(66,242,122,.10);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(66,242,122,.13), transparent 66%);
  opacity: .9;
}

/* =========================================================
   SECTIONS
========================================================= */

.section {
  margin-top: 52px;
}

.section-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.section-title small {
  display: block;
  margin-bottom: 5px;
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 2.3px;
  text-transform: uppercase;
}

.section-title h2 {
  position: relative;
  display: inline-block;
  color: var(--text);
  font-size: 28px;
  font-weight: 900;
  letter-spacing: -1px;
}

.section-title h2::after {
  content: "";
  display: block;
  width: 34px;
  height: 3px;
  margin-top: 9px;
  border-radius: 99px;
  background: var(--green);
  box-shadow: 0 0 15px rgba(66,242,122,.42);
}

#viewerCount {
  flex: 0 0 auto;
  padding: 8px 12px;
  color: var(--text-soft);
  background: rgba(66,242,122,.055);
  border: 1px solid var(--green-border);
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
}

/* =========================================================
   PLAYER
========================================================= */

.player-box {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #000;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: var(--radius-xl);
  box-shadow: 0 30px 85px rgba(0,0,0,.48);
}

#player {
  display: block;
  width: 100%;
  height: 100%;
  background: #000;
  object-fit: contain;
}

.player-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  background: linear-gradient(180deg, rgba(0,0,0,.16), rgba(0,0,0,.78));
  transition: opacity .3s ease;
}

.player-overlay.hidden {
  opacity: 0;
  pointer-events: none;
}

.big-play {
  width: 62px;
  height: 62px;
  display: grid;
  place-items: center;
  margin-bottom: 15px;
  color: #041008;
  background: var(--green);
  border-radius: 50%;
  font-size: 20px;
  box-shadow: 0 12px 35px rgba(66,242,122,.22);
}

.player-overlay h2 {
  font-size: 21px;
  font-weight: 900;
}

.player-overlay p {
  margin-top: 5px;
  color: var(--muted);
  font-size: 12px;
}

.live-overlay-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 13px;
  padding: 6px 10px;
  color: #ff8b99;
  background: rgba(255,64,85,.08);
  border: 1px solid rgba(255,64,85,.20);
  border-radius: 999px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.live-overlay-badge i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--red);
}

.overlay-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 18px;
}

.watch-live-button,
.sound-toggle {
  border: 1px solid var(--green-border);
  border-radius: 9px;
  cursor: pointer;
  font: inherit;
  font-size: 10px;
  font-weight: 900;
}

.watch-live-button {
  padding: 11px 15px;
  color: #041008;
  background: var(--green);
}

.sound-toggle {
  padding: 10px 12px;
  color: var(--text-soft);
  background: rgba(255,255,255,.055);
}

.autoplay-option {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-left: 3px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
}

/* =========================================================
   PLAYER INFO
========================================================= */

.now-playing {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 72px;
  margin-top: 13px;
  padding: 17px 20px;
  background: linear-gradient(145deg, rgba(255,255,255,.045), rgba(255,255,255,.018));
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.now-playing small {
  display: block;
  color: var(--muted);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.now-playing h2 {
  margin-top: 3px;
  font-size: 18px;
  font-weight: 850;
  text-transform: capitalize;
}

.player-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 9px;
  color: var(--green);
  background: var(--green-soft);
  border: 1px solid var(--green-border);
  border-radius: 999px;
  font-size: 9px;
  font-weight: 900;
  white-space: nowrap;
}

.player-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
}

/* =========================================================
   PLAYER TOOLBAR / PREMIUM CONTROLS
========================================================= */

.premium-live-bar {
  display: grid;
  grid-template-columns: auto minmax(0,1fr) auto;
  align-items: center;
  gap: 14px;
  margin-bottom: 12px;
  padding: 11px 14px;
  background: linear-gradient(100deg, rgba(18,38,24,.75), rgba(8,14,10,.85));
  border: 1px solid var(--green-border);
  border-radius: var(--radius-md);
}

.premium-live-mark,
.premium-live-meta {
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.premium-live-copy {
  min-width: 0;
}

.premium-live-copy small {
  display: block;
  margin-bottom: 2px;
  color: var(--muted);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.premium-live-copy strong {
  display: block;
  overflow: hidden;
  color: var(--text);
  font-size: 13px;
  text-overflow: ellipsis;
  text-transform: capitalize;
  white-space: nowrap;
}

.player-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  min-height: 44px;
  padding-top: 8px;
}

.connection-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .7px;
  text-transform: uppercase;
}

.connection-status i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--muted);
}

.connection-status.status-live i {
  background: var(--green);
  box-shadow: 0 0 10px rgba(66,242,122,.55);
}

.connection-status.status-loading i,
.connection-status.status-buffering i,
.connection-status.status-reconnecting i {
  background: var(--yellow);
}

.connection-status.status-offline i,
.connection-status.status-error i {
  background: var(--red);
}

.player-actions {
  display: flex;
  gap: 6px;
}

.player-action {
  padding: 7px 10px;
  color: var(--muted);
  background: rgba(255,255,255,.025);
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 9px;
  font-weight: 800;
}

.player-action:hover,
.player-action[aria-pressed="true"] {
  color: var(--green);
  background: var(--green-soft);
  border-color: var(--green-border);
}

/* =========================================================
   SCOREBOARD
========================================================= */

.live-scoreboard {
  display: none;
  margin-top: 18px;
  padding: 23px;
  overflow: hidden;
  background:
    radial-gradient(circle at 90% 0%, rgba(66,242,122,.08), transparent 28%),
    linear-gradient(145deg, #0c1110, #080b09);
  border: 1px solid var(--green-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow);
}

.scoreboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.scoreboard-header small {
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.scoreboard-header h2 {
  margin-top: 4px;
  font-size: 20px;
  font-weight: 900;
}

.score-live-badge {
  color: #ff7d8c;
  font-size: 10px;
  font-weight: 900;
}

.score-live-badge i {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 5px;
  border-radius: 50%;
  background: var(--red);
}

.innings-score {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 23px 0;
}

.batting-team {
  display: flex;
  align-items: center;
  gap: 12px;
}

.team-logo {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  flex: 0 0 50px;
  color: var(--green);
  background: var(--green-soft);
  border: 1px solid var(--green-border);
  border-radius: 12px;
}

.batting-team strong {
  display: block;
  font-size: 17px;
}

.batting-team span {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 11px;
}

.main-score {
  text-align: right;
}

.main-score strong {
  display: block;
  color: var(--green);
  font-size: clamp(34px,5vw,54px);
  font-weight: 950;
  line-height: 1;
  letter-spacing: -2px;
}

.main-score span {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 11px;
}

.score-details {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 9px;
}

.score-detail {
  padding: 13px;
  text-align: center;
  background: rgba(255,255,255,.028);
  border: 1px solid rgba(255,255,255,.05);
  border-radius: 11px;
}

.score-detail span {
  display: block;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .8px;
  text-transform: uppercase;
}

.score-detail strong {
  display: block;
  margin-top: 5px;
  font-size: 17px;
}

.players-score {
  margin-top: 12px;
  border-top: 1px solid var(--border);
}

.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 3px;
  border-bottom: 1px solid rgba(255,255,255,.045);
}

.player-name {
  font-weight: 800;
}

.player-name b {
  margin-left: 5px;
  color: var(--green);
}

.player-row small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
}

.player-row > strong {
  font-size: 12px;
}

.bowler-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 11px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}

.bowler-row span {
  display: block;
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.bowler-row strong {
  display: block;
  margin-top: 4px;
  font-size: 13px;
}

.score-empty-state {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 18px;
  padding: 20px;
  background: rgba(255,255,255,.018);
  border: 1px dashed rgba(255,255,255,.10);
  border-radius: var(--radius-md);
}

.empty-score-icon {
  display: none !important;
}

.score-empty-state small {
  color: var(--green);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.score-empty-state strong {
  display: block;
  margin-top: 3px;
  font-size: 15px;
}

.score-empty-state p {
  margin-top: 2px;
  color: var(--muted);
  font-size: 11px;
}

/* =========================================================
   QUICK SCORE
========================================================= */

.quick-score {
  display: none;
  align-items: center;
  gap: 8px;
  margin-left: auto;
  margin-right: 18px;
}

.quick-score strong {
  font-size: 17px;
}

.quick-score span {
  color: var(--muted);
  font-size: 11px;
}

/* =========================================================
   MATCHES
========================================================= */

.match-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 17px;
}

.match-search {
  display: flex;
  align-items: center;
  gap: 8px;
  width: min(280px,100%);
  padding: 4px;
  background: rgba(255,255,255,.018);
  border: 1px solid var(--border);
  border-radius: 11px;
}

.match-search > span {
  padding-left: 7px;
  color: var(--green);
  font-size: 14px;
  font-weight: 900;
}

.match-search input {
  width: 100%;
  min-width: 0;
  height: 35px;
  padding: 0 8px;
  color: var(--text);
  background: transparent;
  border: 0;
  outline: 0;
  font: inherit;
  font-size: 11px;
}

.match-search input::placeholder {
  color: var(--muted);
}

.match-filters {
  display: flex;
  gap: 4px;
  padding: 3px;
  background: rgba(255,255,255,.018);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.filter-button {
  padding: 6px 10px;
  color: var(--muted);
  background: transparent;
  border: 0;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 800;
}

.filter-button:hover,
.filter-button.is-active {
  color: #041008;
  background: var(--green);
}

.matches-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px;
}

.match-card {
  position: relative;
  min-width: 0;
  min-height: 210px;
  padding: 19px;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255,255,255,.042), rgba(255,255,255,.012));
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: 0 15px 40px rgba(0,0,0,.16);
  transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}

.match-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-strong);
  box-shadow: 0 22px 50px rgba(0,0,0,.25);
}

.match-card.match-is-live,
.match-card.is-selected {
  border-color: var(--green-border);
}

.match-card.match-is-upcoming {
  opacity: .9;
}

.match-card.match-is-finished {
  opacity: .65;
}

.match-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 15px;
}

.live-label {
  color: var(--red);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.match-is-upcoming .live-label {
  color: var(--yellow);
}

.match-is-finished .live-label {
  color: var(--muted);
}

.match-league {
  color: var(--muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .8px;
  text-transform: uppercase;
}

.team {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,.045);
}

.team:last-of-type {
  border-bottom: 0;
}

.team-name {
  min-width: 0;
  overflow: hidden;
  color: var(--text);
  font-size: 16px;
  font-weight: 850;
  text-overflow: ellipsis;
  text-transform: capitalize;
  white-space: nowrap;
}

.team-score {
  flex: 0 0 auto;
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
}

.watch-button {
  width: 100%;
  min-height: 42px;
  margin-top: 14px;
  padding: 10px 12px;
  color: #041008;
  background: var(--green);
  border: 1px solid rgba(66,242,122,.25);
  border-radius: 10px;
  font-size: 11px;
  font-weight: 900;
  transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
}

.watch-button:hover {
  transform: translateY(-1px);
  filter: brightness(1.04);
  box-shadow: 0 10px 25px rgba(66,242,122,.15);
}

.watch-button:disabled {
  color: #747d77;
  background: rgba(255,255,255,.035);
  border-color: rgba(255,255,255,.06);
  cursor: not-allowed;
  box-shadow: none;
  transform: none;
}

.match-is-live .watch-button {
  color: #041008;
  background: var(--green);
}

.match-is-upcoming .watch-button,
.match-is-finished .watch-button {
  color: #747d77;
  background: rgba(255,255,255,.035);
}

/* =========================================================
   TOURNAMENTS / INFO
========================================================= */

.tournament-grid {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 16px;
}

.tournament-card {
  position: relative;
  min-height: 145px;
  padding: 22px;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(255,255,255,.04), rgba(255,255,255,.012));
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  transition: transform .22s ease, border-color .22s ease;
}

.tournament-card:hover {
  transform: translateY(-4px);
  border-color: var(--green-border);
}

.tournament-card > div {
  margin-bottom: 12px;
  color: var(--green);
  font-size: 20px;
}

.tournament-card h3 {
  font-size: 15px;
  font-weight: 850;
}

.tournament-card p {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

.info-section {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 14px;
  margin-top: 34px;
}

.info-card {
  padding: 18px;
  background: linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.012));
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
}

.info-card span {
  display: block;
  margin-bottom: 7px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}

.info-card strong {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
}

.info-card strong i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 10px rgba(66,242,122,.5);
}

/* =========================================================
   STICKY SCORE / TOAST
========================================================= */

.sticky-score-bar {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 1100;
  display: flex;
  align-items: center;
  gap: 17px;
  min-width: min(410px, calc(100vw - 44px));
  padding: 11px 12px 11px 15px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(10px);
  background: rgba(8,13,10,.94);
  border: 1px solid var(--green-border);
  border-radius: 13px;
  box-shadow: 0 20px 50px rgba(0,0,0,.38);
  backdrop-filter: blur(16px);
  transition: opacity .22s ease, transform .22s ease;
}

.sticky-score-bar.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.sticky-score-copy {
  min-width: 0;
  flex: 1;
}

.sticky-score-copy span,
.sticky-score-copy strong,
.sticky-score-value strong,
.sticky-score-value span {
  display: block;
}

.sticky-score-copy span {
  color: var(--green);
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1px;
}

.sticky-score-copy strong {
  margin-top: 2px;
  overflow: hidden;
  font-size: 11px;
  text-overflow: ellipsis;
  text-transform: capitalize;
  white-space: nowrap;
}

.sticky-score-value {
  text-align: right;
}

.sticky-score-value strong {
  color: var(--green);
  font-size: 16px;
}

.sticky-score-value span {
  color: var(--muted);
  font-size: 9px;
}

#stickyScoreClose {
  width: 25px;
  height: 25px;
  display: grid;
  place-items: center;
  color: var(--muted);
  background: rgba(255,255,255,.025);
  border: 1px solid var(--border);
  border-radius: 50%;
}

.action-toast {
  position: fixed;
  left: 50%;
  bottom: 25px;
  z-index: 1200;
  max-width: calc(100vw - 30px);
  padding: 9px 13px;
  color: var(--text-soft);
  background: rgba(10,15,12,.94);
  border: 1px solid var(--green-border);
  border-radius: 999px;
  box-shadow: 0 15px 35px rgba(0,0,0,.3);
  font-size: 10px;
  font-weight: 800;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%,10px);
  transition: opacity .22s ease, transform .22s ease;
}

.action-toast.is-visible {
  opacity: 1;
  transform: translate(-50%,0);
}

/* =========================================================
   MOBILE NAV
========================================================= */

.mobile-bottom-nav {
  display: none;
}

/* =========================================================
   THEATER / FOCUS MODES
========================================================= */

body.theater-mode {
  background: #020303;
}

body.theater-mode main {
  width: 100%;
  max-width: none;
}

body.theater-mode #live,
body.focus-mode #live {
  width: min(1500px, calc(100% - 40px));
  margin-left: auto;
  margin-right: auto;
}

body.theater-mode main > :not(#live),
body.focus-mode main > :not(#live),
body.theater-mode footer,
body.focus-mode footer {
  opacity: .35;
  filter: saturate(.55);
  transition: opacity .25s ease, filter .25s ease;
}

/* =========================================================
   FOOTER
========================================================= */

footer {
  margin-top: 70px;
  padding: 38px 20px;
  text-align: center;
  background: #030504;
  border-top: 1px solid var(--border);
}

footer .brand {
  justify-content: center;
  font-size: 18px;
}

footer p {
  margin-top: 6px;
  color: var(--muted);
  font-size: 10px;
}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
  width: 7px;
}

::-webkit-scrollbar-track {
  background: var(--bg);
}

::-webkit-scrollbar-thumb {
  background: #273029;
  border-radius: 99px;
}

::-webkit-scrollbar-thumb:hover {
  background: #39483e;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 950px) {
  .hero-ball {
    right: 30px;
    width: 170px;
    height: 170px;
  }

  .matches-grid,
  .tournament-grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }

  .info-section {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 700px) {
  body {
    padding-bottom: 70px;
  }

  .topbar {
    height: 64px;
    padding: 0 16px;
  }

  .brand {
    font-size: 17px;
  }

  nav {
    display: none;
  }

  .live-badge {
    padding: 6px 9px;
    font-size: 9px;
  }

  main {
    width: calc(100% - 24px);
    padding-bottom: 50px;
  }

  .hero {
    min-height: 330px;
    margin-top: 16px;
    border-radius: 17px;
  }

  .hero-content {
    padding: 38px 24px;
  }

  .hero h1 {
    font-size: clamp(40px, 12vw, 58px);
    letter-spacing: -2.7px;
  }

  .hero-description {
    max-width: 100%;
    font-size: 13px;
    line-height: 1.6;
  }

  .hero-ball {
    display: none;
  }

  .section {
    margin-top: 38px;
  }

  .section-title {
    align-items: center;
    margin-bottom: 14px;
  }

  .section-title h2 {
    font-size: 23px;
  }

  .player-box {
    border-radius: 15px;
  }

  .now-playing {
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    align-items: center;
    padding: 15px;
  }

  .now-playing h2 {
    max-width: 210px;
    overflow: hidden;
    font-size: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player-toolbar {
    display: block;
  }

  .connection-status {
    margin-bottom: 8px;
  }

  .player-actions {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
  }

  .player-action {
    width: 100%;
    padding-left: 5px;
    padding-right: 5px;
  }

  .premium-live-bar {
    grid-template-columns: auto minmax(0,1fr);
    gap: 9px;
  }

  .premium-live-meta {
    grid-column: 2;
  }

  .live-scoreboard {
    padding: 16px;
    border-radius: 16px;
  }

  .innings-score {
    gap: 12px;
    padding: 20px 0;
  }

  .main-score strong {
    font-size: 31px;
  }

  .score-details {
    gap: 6px;
  }

  .score-detail {
    padding: 11px 5px;
  }

  .score-detail strong {
    font-size: 15px;
  }

  .match-tools {
    display: block;
  }

  .match-search {
    width: 100%;
  }

  .match-filters {
    width: 100%;
    margin-top: 8px;
  }

  .filter-button {
    flex: 1;
  }

  .matches-grid,
  .tournament-grid,
  .info-section {
    grid-template-columns: 1fr;
  }

  .match-card {
    min-height: 185px;
  }

  .sticky-score-bar {
    right: 12px;
    left: 12px;
    bottom: 68px;
    min-width: 0;
  }

  .action-toast {
    bottom: 78px;
  }

  .mobile-bottom-nav {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1050;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    padding: 8px 8px max(8px, env(safe-area-inset-bottom));
    background: rgba(5,8,6,.94);
    border-top: 1px solid var(--border);
    box-shadow: 0 -12px 30px rgba(0,0,0,.28);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .mobile-bottom-nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    color: var(--muted);
    text-decoration: none;
    border-radius: 8px;
    font-size: 9px;
    font-weight: 800;
  }

  .mobile-bottom-nav a:hover,
  .mobile-bottom-nav a.is-active {
    color: var(--green);
    background: var(--green-soft);
  }

  body.theater-mode #live,
  body.focus-mode #live {
    width: calc(100% - 24px);
  }
}

@media (max-width: 400px) {
  .hero h1 {
    font-size: 38px;
  }

  .section-title h2 {
    font-size: 21px;
  }

  .score-details {
    grid-template-columns: repeat(3,1fr);
  }

  .team-logo {
    width: 43px;
    height: 43px;
    flex-basis: 43px;
  }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@keyframes pulse {
  0%,100% { opacity: 1; transform: scale(1); }
  50% { opacity: .55; transform: scale(.8); }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

/* =========================================================
   REFRESH BUTTON — FINAL
   ========================================================= */

#refreshBtn {
  appearance: none;
  -webkit-appearance: none;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 104px;
  height: 42px;
  padding: 0 18px;

  border: 1px solid rgba(70, 255, 132, 0.22);
  border-radius: 12px;

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.025)
    );

  color: #d9e3df;

  font-family: inherit;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.01em;

  cursor: pointer;

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

#refreshBtn:hover {
  border-color: rgba(70, 255, 132, 0.5);

  background:
    linear-gradient(
      180deg,
      rgba(70, 255, 132, 0.12),
      rgba(70, 255, 132, 0.045)
    );

  color: #4cff8a;

  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.34),
    0 0 22px rgba(70, 255, 132, 0.08);

  transform: translateY(-1px);
}

#refreshBtn:active {
  transform: translateY(0);
}

#refreshBtn:focus-visible {
  outline: none;

  border-color: #4cff8a;

  box-shadow:
    0 0 0 3px rgba(70, 255, 132, 0.12),
    0 0 24px rgba(70, 255, 132, 0.08);
}

#refreshBtn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}

/* Keep refresh aligned with match section controls */
.matches-toolbar,
.matches-header,
.match-controls {
  position: relative;
}

#refreshBtn {
  margin-left: auto;
}

/* Mobile */
@media (max-width: 700px) {
  #refreshBtn {
    min-width: 92px;
    height: 40px;
    padding: 0 14px;
    font-size: 12px;
  }
}